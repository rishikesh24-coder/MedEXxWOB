# MedEx Frontend Environment Variables Template
# Copy to .env or set in deployment platform (e.g., Vercel, Netlify, Cloudflare Pages)

# API Base URL configuration
# In local development:
# - Leave unset or set to /api.
# - Vite development server automatically proxies /api to http://localhost:5000.
# In production:
# - Set to your deployed backend API URL (e.g., https://api.medex.example.com or https://api.medex.example.com/api).
# - Trailing slashes and redundant /api paths are automatically normalized safely.
VITE_API_BASE_URL=/api

# Supabase Client Configuration (Public Anon Key only; never commit Service Role Keys)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-anon-key-here

# ==============================================================================
# MedEx Backend Environment Variables
# ==============================================================================
# Port & Runtime Environment
PORT=5000
NODE_ENV=development

# CORS Configuration (Production Security Hardening)
# In production, specify a comma-separated list of allowed frontend origins:
# CORS_ORIGINS=https://app.medex.example.com,https://admin.medex.example.com
# In development, leave empty to automatically allow local Vite origins (localhost:5173, localhost:3000)
CORS_ORIGINS=

