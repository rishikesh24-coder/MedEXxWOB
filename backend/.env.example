# ==============================================================================
# MedEx Backend Environment Variables Template
# Copy to backend/.env for local development or set in deployment container
# NEVER COMMIT SECRETS TO SOURCE CONTROL
# ==============================================================================

PORT=5000
NODE_ENV=development

# ------------------------------------------------------------------------------
# CORS Configuration (Production Security Hardening)
# ------------------------------------------------------------------------------
# In production (NODE_ENV=production):
# Must be a comma-separated list of fully qualified allowed browser origins:
# CORS_ORIGINS=https://app.medex.example.com,https://admin.medex.example.com
# Trailing slashes and whitespace are automatically trimmed.
# Wildcards (*) are strictly forbidden when credentials are enabled.
# If left empty in production, all cross-origin browser requests are blocked.
#
# In development (NODE_ENV=development):
# Local development origins (localhost:5173, localhost:3000, 127.0.0.1) are
# automatically permitted. Additional origins can be appended here.
CORS_ORIGINS=

# ------------------------------------------------------------------------------
# Supabase Configuration
# ------------------------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-publishable-anon-key-here
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here (Keep strictly private)

# ------------------------------------------------------------------------------
# Security & Rate Limiting (Optional Overrides)
# ------------------------------------------------------------------------------
# TRUST_PROXY=true
# MAX_DOCUMENT_SIZE_MB=5
# AUTH_RATE_LIMIT_MAX=100
# REGISTRATION_RATE_LIMIT_MAX=50
# GENERAL_RATE_LIMIT_MAX=3000
